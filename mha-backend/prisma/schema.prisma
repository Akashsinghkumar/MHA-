generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== CORE E-COMMERCE ====================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?  @unique
  phone        String   @unique
  passwordHash String   @map("password_hash")
  referralCode String   @unique @map("referral_code")
  referredById Int?     @map("referred_by_id")
  referredBy   User?    @relation("ReferralTree", fields: [referredById], references: [id])
  referrals    User[]   @relation("ReferralTree")
  kycStatus    String   @default("Pending") @map("kyc_status")
  isBlocked    Boolean  @default(false) @map("is_blocked")
  carryForward Decimal  @default(0) @map("carry_forward")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses         Address[]
  cartItems         CartItem[]
  orders            Order[]
  wishlists         Wishlist[]
  reviews           Review[]
  supportTickets    SupportTicket[]
  warrantyClaims    WarrantyClaim[]
  serviceBookings   ServiceBooking[]
  galleryItems      GalleryItem[]
  units             MemberUnit[]
  commissionsEarned Commission[]      @relation("CommissionEarner")
  commissionsFrom   Commission[]      @relation("CommissionSource")
  profitShares      ProfitSharing[]
  sponsorBenefits   SponsorBenefit[]
  salaryRanks       SalaryRank[]
  fundProgress      FundProgress?
  rewardClaims      RewardClaim[]
  ledgerEntries     FinancialLedger[]
  payouts           Payout[]
  kycDocuments      KycDocument[]

  @@map("users")
}

model Address {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String  @map("full_name")
  phone       String
  addressLine String  @map("address_line")
  city        String
  state       String
  pincode     String
  isDefault   Boolean @default(false) @map("is_default")

  orders Order[]

  @@map("addresses")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  imageUrl  String?    @map("image_url")
  sortOrder Int        @default(0) @map("sort_order")

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  subcategory String
  brand       String   @default("MHA")
  actualPrice Decimal  @map("actual_price")
  offerPrice  Decimal  @map("offer_price")
  rating      Decimal  @default(4.5)
  stock       Int      @default(50)
  imageUrl    String   @map("image_url")
  emoji       String?
  accentColor String?  @map("accent_color")
  tags        String   @default("[]") // JSON array string
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlists     Wishlist[]
  reviews       Review[]
  offerProducts OfferProduct[]

  @@index([categoryId])
  @@index([subcategory])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("product_images")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart")
}

model Order {
  id              Int      @id @default(autoincrement())
  orderNumber     String   @unique @map("order_number")
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  addressId       Int?     @map("address_id")
  address         Address? @relation(fields: [addressId], references: [id])
  shippingAddress String   @map("shipping_address")
  subtotal        Decimal
  discountAmount  Decimal  @default(0) @map("discount_amount")
  total           Decimal
  couponCode      String?  @map("coupon_code")
  status          String   @default("Processing")
  statusNote      String?  @map("status_note")
  paymentMethod   String   @map("payment_method")
  paymentStatus   String   @default("Pending") @map("payment_status")
  unitsEarned     Int      @default(0) @map("units_earned")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items          OrderItem[]
  payments       Payment[]
  warrantyClaims WarrantyClaim[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal
  subtotal  Decimal

  @@map("order_items")
}

model Payment {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String   @default("Razorpay")
  gatewayOrderId   String?  @unique @map("gateway_order_id")
  gatewayPaymentId String?  @unique @map("gateway_payment_id")
  gatewaySignature String?  @map("gateway_signature")
  amount           Decimal
  currency         String   @default("INR")
  status           String   @default("Created")
  refundAmount     Decimal? @map("refund_amount")
  refundReason     String?  @map("refund_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  reviewText String   @map("review_text")
  isVerified Boolean  @default(false) @map("is_verified")
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String    @map("discount_type")
  discountValue Decimal   @map("discount_value")
  minOrder      Decimal   @default(0) @map("min_order")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  expiryDate    DateTime? @map("expiry_date")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

// ==================== CMS, GALLERY & SUPPORT ====================

model Offer {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  tagline     String?
  description String?
  bannerImage String?   @map("banner_image")
  promoCode   String?   @map("promo_code")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  products OfferProduct[]

  @@map("offers")
}

model OfferProduct {
  offerId   Int     @map("offer_id")
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@map("offer_products")
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  category    String?
  description String?
  location    String?
  imageUrl    String?  @map("image_url")
  videoUrl    String?  @map("video_url")
  isApproved  Boolean  @default(false) @map("is_approved")
  uploadedBy  Int?     @map("uploaded_by")
  user        User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("gallery")
}

model SupportTicket {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @unique @map("ticket_number")
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  subject      String?
  message      String
  adminReply   String?  @map("admin_reply")
  status       String   @default("Open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model WarrantyClaim {
  id          Int      @id @default(autoincrement())
  claimNumber String   @unique @map("claim_number")
  userId      Int?     @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     Int?     @map("order_id")
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber String   @map("order_number")
  issue       String
  status      String   @default("New")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("warranty_claims")
}

model ServiceBooking {
  id            Int       @id @default(autoincrement())
  bookingNumber String    @unique @map("booking_number")
  userId        Int?      @map("user_id")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  phone         String
  product       String
  serviceType   String    @map("service_type")
  status        String    @default("Requested")
  bookingDate   DateTime? @map("booking_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("service_bookings")
}

model Faq {
  id        Int    @id @default(autoincrement())
  question  String
  answer    String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("faqs")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model HeroBanner {
  id            Int      @id @default(autoincrement())
  kicker        String?
  title         String
  highlightText String?  @map("highlight_text")
  description   String
  buttonText    String   @map("button_text")
  buttonRoute   String   @map("button_route")
  imageUrl      String   @map("image_url")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("hero_banners")
}

model PageContent {
  pageKey   String   @id @map("page_key")
  badge     String?
  title     String
  subtitle  String?
  imageUrl  String?  @map("image_url")
  ctaText   String?  @map("cta_text")
  ctaRoute  String?  @map("cta_route")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_contents")
}

// ==================== MLM / BUSINESS PLAN ====================

model MemberUnit {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitNumber  Int       @map("unit_number")
  totalPaid   Decimal   @default(0) @map("total_paid")
  maxCap      Decimal   @default(5000) @map("max_cap")
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("member_units")
}

model Commission {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation("CommissionEarner", fields: [userId], references: [id])
  sourceUserId Int       @map("source_user_id")
  sourceUser   User      @relation("CommissionSource", fields: [sourceUserId], references: [id])
  orderId      Int?      @map("order_id")
  level        Int
  ratePercent  Decimal   @map("rate_percent")
  amount       Decimal
  status       String    @default("Pending")
  closingDate  DateTime? @map("closing_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("commissions")
}

model ProfitSharing {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  month        String
  companyPool  Decimal  @map("company_pool")
  activeUnits  Int      @map("active_units")
  sharePerUnit Decimal  @map("share_per_unit")
  userUnits    Int      @map("user_units")
  amount       Decimal
  status       String   @default("Completed")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("profit_sharing")
}

model SponsorBenefit {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  generation   Int
  ratePercent  Decimal  @map("rate_percent")
  amount       Decimal
  month        String
  monthsActive Int      @default(1) @map("months_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sponsor_benefits")
}

model SalaryRank {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  designation    String
  rankBusiness   String   @map("rank_business")
  monthlySelf    Decimal  @map("monthly_self")
  monthlyTeam    Decimal  @map("monthly_team")
  salaryAmount   Decimal  @map("salary_amount")
  ratioQualified Boolean  @default(false) @map("ratio_qualified")
  month          String
  status         String   @default("Pending")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("salary_ranks")
}

model FundProgress {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  totalBusiness  Decimal  @default(0) @map("total_business")
  travellingFund Decimal  @default(0) @map("travelling_fund")
  carFund        Decimal  @default(0) @map("car_fund")
  houseFund      Decimal  @default(0) @map("house_fund")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("fund_progress")
}

model RewardClaim {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  tierLabel  String   @map("tier_label")
  rewardName String   @map("reward_name")
  action     String
  status     String   @default("Recorded")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("rewards")
}

model FinancialLedger {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  entryTitle  String   @map("entry_title")
  type        String
  category    String
  amount      Decimal
  status      String   @default("Pending")
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("financial_ledger")
}

model Payout {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id])
  requestedAmount Decimal   @map("requested_amount")
  deductionAmount Decimal   @map("deduction_amount")
  netAmount       Decimal   @map("net_amount")
  bankOrUpi       String    @map("bank_or_upi")
  utrNumber       String?   @map("utr_number")
  status          String    @default("Pending")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")

  @@index([userId])
  @@map("payouts")
}

model KycDocument {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String    @map("full_name")
  panNumber  String    @map("pan_number")
  bankOrUpi  String    @map("bank_or_upi")
  docUrl     String?   @map("doc_url")
  status     String    @default("Pending")
  reviewNote String?   @map("review_note")
  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  @@map("kyc_documents")
}

model ClosingLog {
  id           Int      @id @default(autoincrement())
  closingType  String   @map("closing_type")
  periodLabel  String   @map("period_label")
  totalAmount  Decimal  @map("total_amount")
  recordsCount Int      @map("records_count")
  runBy        String   @map("run_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("closing_logs")
}

// ==================== ADMIN & SECURITY ====================

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("SUPER_ADMIN")
  permissions  String    @default("[]") // JSON array string
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  logs AdminLog[]

  @@map("admin_users")
}

model AdminLog {
  id        Int       @id @default(autoincrement())
  adminId   Int       @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id])
  action    String
  details   String?
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_logs")
}
