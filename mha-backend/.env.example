# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Hostinger / GoDaddy VPS / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mha_db?schema=public"

# JWT Secrets (Change these in production!)
JWT_SECRET="change_this_to_a_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change_this_admin_secret_to_another_strong_random_string"
ADMIN_JWT_EXPIRES_IN="12h"

# CORS Allowed Origins (Public Website + Admin Panel)
PUBLIC_SITE_URL="http://127.0.0.1:5174"
ADMIN_PANEL_URL="http://127.0.0.1:5175"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloud Storage (Optional: S3 / Cloudinary, falls back to local /uploads)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notifications (Optional: SMTP / MSG91 / Twilio)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMS_API_KEY=""
SMS_SENDER_ID="MHAONL"

# Initial Admin Seed Credentials (only used during prisma:seed)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@mha-shop.com"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
